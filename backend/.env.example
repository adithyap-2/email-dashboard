# =============================================================================
# Relationship Intelligence Dashboard — configuration
#
# Copy to backend/.env and fill in. Never commit the filled-in file; it is
# gitignored and excluded from the Docker build context.
#
# Full walkthrough: docs/SETUP.md
# =============================================================================

# --- Where the app is reachable ---------------------------------------------
# The single URL teammates open. Everything else (the Microsoft redirect, the
# session cookie's Secure flag) is derived from it.
#   laptop / single user : http://localhost:8000
#   shared server        : https://dashboard.cridindia.com
# This EXACT value + /auth/callback must be registered as a Redirect URI on the
# Entra app registration, or sign-in fails with AADSTS50011.
PUBLIC_BASE_URL=http://localhost:8000

# Optional override if the callback path differs from PUBLIC_BASE_URL + /auth/callback.
# Leave commented out unless you have a reason.
# REDIRECT_URI=http://localhost:8000/auth/callback


# --- Microsoft sign-in (delegated — each teammate's own account) -------------
CLIENT_ID=<application (client) id of the "Dashboard" app registration>
CLIENT_SECRET=<client secret VALUE — not the Secret ID>

# Use your TENANT ID, not "common". "common" would let any Microsoft account in
# the world attempt sign-in; the tenant-specific authority limits it to CRID.
AUTHORITY=https://login.microsoftonline.com/<tenant-id>

GRAPH_SCOPES=User.Read Mail.Read Mail.ReadWrite Mail.Send Calendars.Read

# Extra guard on top of the tenant check: only these email domains get a
# session. Keeps out guest accounts invited into the tenant. Comma-separated.
ALLOWED_EMAIL_DOMAINS=cridindia.com


# --- Data ---------------------------------------------------------------
# SQLite file the dashboard reads and n8n writes to. In Docker this is
# overridden to /data/data.db so it survives rebuilds (see docker-compose.yml).
DB_PATH=data.db

# Bootstrap copy of the engagement sheet, used until n8n syncs the live
# SharePoint version. After that n8n owns the table.
ENGAGEMENT_XLSX=../Engagement Sheet.xlsx
ENGAGEMENT_SHEET=Updated Engagement Sheet

# Domains treated as internal (i.e. NOT an external contact) when tagging
# emails and meetings. Comma-separated.
INTERNAL_DOMAINS=cridindia.com

# Pin the dashboard's notion of "today" for follow-up categorisation. Leave
# commented out to use the real date. Format: YYYY-MM-DD.
# DASHBOARD_TODAY=2026-07-24


# --- n8n automation ----------------------------------------------------------
# 'db'    = the dashboard reads what n8n ingested (history + shared sheet sync).
# 'graph' = live per-user Microsoft calls on every page load, no n8n needed.
# Use 'graph' until the n8n workflows are running, then switch to 'db'.
DASHBOARD_SOURCE=db

# Shared secret n8n sends as the X-Ingest-Key header to write to /ingest/*.
# Ingestion is refused outright if this is blank (fail closed).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=


# --- AI assistant (optional) --------------------------------------------------
# Powers the /chat assistant. The dashboard works without these.
ZAI_API_KEY=<your z.ai key>
ZAI_MODEL=glm-5.2
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Senders the assistant should ignore when summarising mail. Comma-separated.
IGNORED_SENDERS=noreply@github.com,noreply@nvidia.com
